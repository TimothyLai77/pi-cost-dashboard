{
  "name": "pi-cost-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + SQLite + React dashboard for Pi coding-agent session cost",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "backfill": "node --env-file-if-exists=.env server/cli-backfill.js",
    "verify": "node --env-file-if-exists=.env server/cli-verify.js",
    "migrate": "node --env-file-if-exists=.env server/cli-migrate.js",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.1",
    "vite": "^7.1.14"
  }
}
