# Pi cost dashboard server configuration. Copy to .env and edit.

# Listen address and port. Default is localhost only: this server is not internet-facing.
PI_COST_HOST=127.0.0.1
PI_COST_PORT=4870

# SQLite file. Defaults to dashboard/data/cost.db.
# PI_COST_DB=/absolute/path/cost.db

# Pi sessions directory. Resolution order is CLI flag, this variable, Pi's sessionDir
# setting, then ~/.pi/agent/sessions.
# PI_COST_SESSIONS_DIR=/home/you/.pi/agent/sessions

# Shared secret. When set, POST /api/ingest and POST /api/rescan require the
# x-pi-cost-token header to match. Reads stay open so the dashboard opens in a browser.
# PI_COST_TOKEN=generate-a-random-value

# URL the Pi extension reports to. Set this in the environment Pi runs under.
PI_COST_URL=http://127.0.0.1:4870/api/ingest

# Extension tuning. Automatic reporting is enabled when PI_COST_URL is set.
# PI_COST_AUTO=0 disables it for a session's process.
PI_COST_AUTO=1
PI_COST_TIMEOUT_MS=5000
PI_COST_MIN_INTERVAL_MS=10000
