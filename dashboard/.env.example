# Pi cost dashboard server configuration. Copy to .env and edit.

# Listen address and port. Default is localhost only. Inside the container the server
# always binds 0.0.0.0 so the published port is reachable; who can connect is decided by
# the host-side binding below.
PI_COST_HOST=127.0.0.1
PI_COST_PORT=4870

# compose.yml host-side port mapping.
#   127.0.0.1:4870:4870  loopback only, for testing on the host itself
#   0.0.0.0:4870:4870    reachable from the LAN
PI_COST_BIND=127.0.0.1:4870:4870

# SQLite file. Defaults to dashboard/data/cost.db.
# PI_COST_DB=/absolute/path/cost.db

# Pi sessions directory. Resolution order is CLI flag, this variable, Pi's sessionDir
# setting, then ~/.pi/agent/sessions. The compose deployment points this at an empty
# directory inside the image because that deployment is fed by extension pushes; mount a
# Pi sessions directory read-only and set this to it if you want local history scanned.
# PI_COST_SESSIONS_DIR=/home/you/.pi/agent/sessions

# Shared secret. When set, POST /api/ingest and POST /api/rescan require the
# x-pi-cost-token header to match. Reads stay open so the dashboard opens in a browser.
# Generate one with: openssl rand -hex 24
# PI_COST_TOKEN=generate-a-random-value

# URL the Pi extension reports to. Set this in the environment Pi runs under. For a LAN
# deployment this is the dashboard host's address, for example
# http://dashboard-box.local:4870/api/ingest or http://192.168.1.20:4870/api/ingest.
PI_COST_URL=http://127.0.0.1:4870/api/ingest

# Extension tuning. Automatic reporting is enabled when PI_COST_URL is set.
# PI_COST_AUTO=0 disables it for a session's process.
PI_COST_AUTO=1
PI_COST_TIMEOUT_MS=5000
PI_COST_MIN_INTERVAL_MS=10000
